{
  "openapi": "3.0.3",
  "info": {
    "title": "Stokari API",
    "version": "1.0.0",
    "description": "Backend API documentation for Stokari inventory & user management"
  },
  "paths": {
    "/v1/auth/google": {
      "post": {
        "operationId": "v1_auth_google_create",
        "description": "Validates Google ID token and nonce, retrieves or provisions User, and returns an AuthSession with access token, refresh token, and offline lease.",
        "summary": "Exchange Google ID token for Stokari session",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleSignInRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/GoogleSignInRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/GoogleSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": ""
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/v1/auth/lease": {
      "post": {
        "operationId": "v1_auth_lease_create",
        "description": "Issues a renewed 7-day offline lease for the caller's active shop membership.",
        "summary": "Renew offline authorization lease",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeaseRenewRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/LeaseRenewRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/LeaseRenewRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaseRenewResponse"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "v1_auth_logout_create",
        "description": "Revokes the presented refresh token. Always succeeds with 204.",
        "summary": "Logout and revoke refresh token",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No response body"
          }
        }
      }
    },
    "/v1/auth/nonce": {
      "get": {
        "operationId": "v1_auth_nonce_retrieve",
        "description": "Returns a cryptographically random single-use nonce valid for 5 minutes.",
        "summary": "Get one-time sign-in nonce",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NonceResponse"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "v1_auth_refresh_create",
        "description": "Rotates refresh token. Detects token reuse (revoking entire token family) and checks for account deactivation (issuing a drain token if deactivated).",
        "summary": "Rotate refresh token",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthSession": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "session": {
            "$ref": "#/components/schemas/SessionInfo"
          },
          "lease": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LeaseInfo"
              }
            ],
            "nullable": true
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "lease",
          "refreshToken",
          "refreshTokenExpiresAt",
          "serverTime",
          "session"
        ]
      },
      "GoogleSignInRequest": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "Google ID token (JWT)"
          },
          "nonce": {
            "type": "string",
            "description": "Nonce previously returned by E-02"
          },
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "description": "Client device ID (UUIDv7)"
          },
          "membershipId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Optional target membership ID when multiple shops exist"
          }
        },
        "required": [
          "deviceId",
          "idToken",
          "nonce"
        ]
      },
      "LeaseInfo": {
        "type": "object",
        "properties": {
          "leaseId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "allowedOps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "allowedOps",
          "expiresAt",
          "issuedAt",
          "leaseId",
          "token"
        ]
      },
      "LeaseRenewRequest": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "description": "Client device ID"
          }
        },
        "required": [
          "deviceId"
        ]
      },
      "LeaseRenewResponse": {
        "type": "object",
        "properties": {
          "lease": {
            "$ref": "#/components/schemas/LeaseInfo"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "lease",
          "serverTime"
        ]
      },
      "LogoutRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token to revoke"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "MembershipChoice": {
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "shopId": {
            "type": "string",
            "format": "uuid"
          },
          "shopName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "membershipId",
          "role",
          "shopId",
          "shopName"
        ]
      },
      "NonceResponse": {
        "type": "object",
        "properties": {
          "nonce": {
            "type": "string",
            "description": "One-time nonce for Google sign-in"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiration timestamp (ISO-8601)"
          }
        },
        "required": [
          "expiresAt",
          "nonce"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI identifying the error type"
          },
          "title": {
            "type": "string",
            "description": "Short summary of the error"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "detail": {
            "type": "string",
            "description": "Detailed error description"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable error code"
          },
          "drainToken": {
            "type": "string",
            "description": "Temporary token for drain flow"
          },
          "drainTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipChoice"
            },
            "description": "List of available memberships"
          }
        },
        "required": [
          "detail",
          "status",
          "title",
          "type"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Opaque refresh token"
          },
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "description": "Client device ID"
          }
        },
        "required": [
          "deviceId",
          "refreshToken"
        ]
      },
      "SessionInfo": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "shopId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "membershipId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "email",
          "membershipId",
          "name",
          "role",
          "shopId",
          "userId"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
